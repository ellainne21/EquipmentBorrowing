<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="550">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<DockPanel>
		<Border DockPanel.Dock="Top" Padding="16" Background="#1E293B">
			<TextBlock Text="Campus Equipment Borrowing System"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold" />
		</Border>

		<Border DockPanel.Dock="Left" Width="180" Background="#F1F5F9" Padding="12">
			<StackPanel Spacing="8">
				<Button Content="Equipment"
                        Command="{Binding ShowEquipmentCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" />
				<Button Content="Active Borrowings"
                        Command="{Binding ShowBorrowingsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" />
			</StackPanel>
		</Border>

		<ContentControl Content="{Binding CurrentPage}" Margin="16" />
	</DockPanel>
</Window>