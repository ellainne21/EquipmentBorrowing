<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">

	<Grid ColumnDefinitions="*,300" ColumnSpacing="12">

		<!-- Left: search + list -->
		<Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">

			<TextBlock Grid.Row="0" Text="Students"
                       FontSize="20" FontWeight="Bold" Foreground="#831843" />

			<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
				<TextBox Grid.Column="0" Text="{Binding SearchText}">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
					</TextBox.KeyBindings>
				</TextBox>
				<Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                        Background="#F472B6" Foreground="White" />
				<Button Grid.Column="2" Content="Clear" Command="{Binding ClearSearchCommand}"
                        Background="#FBCFE8" Foreground="#831843" />
			</Grid>

			<StackPanel Grid.Row="2" Spacing="4" IsVisible="{Binding IsLoading}">
				<TextBlock Text="Loading students..." Foreground="#831843" />
				<ProgressBar IsIndeterminate="True" />
			</StackPanel>

			<Grid Grid.Row="3">
				<ListBox ItemsSource="{Binding Students}"
                         SelectedItem="{Binding SelectedStudent}"
                         Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:StudentRow">
							<Border Padding="10" Margin="0,2" Background="White"
                                    BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="6">
								<Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="12">
									<TextBlock Grid.Column="0" Text="{Binding StudentNumber}"
                                               FontWeight="Bold" Foreground="#831843" />
									<StackPanel Grid.Column="1">
										<TextBlock Text="{Binding FullName}" />
										<TextBlock Text="{Binding ContactText}" FontSize="12" Foreground="#6B7280" />
									</StackPanel>
									<TextBlock Grid.Column="2" Text="{Binding EligibilityText}" />
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Empty state: the query worked but returned no rows -->
				<TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
                           Foreground="#831843" TextWrapping="Wrap"
                           VerticalAlignment="Top" Margin="4" />

				<!-- Error state: the database could not be reached -->
				<StackPanel IsVisible="{Binding HasLoadError}" Spacing="8" VerticalAlignment="Top" Margin="4">
					<TextBlock Text="{Binding LoadError}" Foreground="#B91C1C" TextWrapping="Wrap" />
					<Button Content="Retry" Command="{Binding SearchCommand}"
                            Background="#F472B6" Foreground="White" />
				</StackPanel>
			</Grid>
		</Grid>

		<!-- Right: form -->
		<ScrollViewer Grid.Column="1">
			<Border Padding="12" Background="#FDF2F8" BorderBrush="#FBCFE8"
                    BorderThickness="1" CornerRadius="8">
				<StackPanel Spacing="6">
					<TextBlock Text="Student details" FontWeight="Bold" Foreground="#831843" />

					<TextBlock Text="Student number" />
					<TextBox Text="{Binding FormStudentNumber}" />

					<TextBlock Text="Full name" />
					<TextBox Text="{Binding FormFullName}" />

					<TextBlock Text="Contact (optional)" />
					<TextBox Text="{Binding FormContact}" />

					<Button Content="Register as new student" Command="{Binding RegisterCommand}"
                            HorizontalAlignment="Stretch" Background="#F472B6" Foreground="White" />
					<Button Content="Save changes to selected" Command="{Binding UpdateCommand}"
                            HorizontalAlignment="Stretch" Background="#F472B6" Foreground="White" />
					<Button Content="Clear form" Command="{Binding NewStudentCommand}"
                            HorizontalAlignment="Stretch" Background="#FBCFE8" Foreground="#831843" />

					<Border Height="1" Background="#FBCFE8" Margin="0,6" />

					<TextBlock Text="Borrowing eligibility" FontWeight="Bold" Foreground="#831843" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Content="Permit" Command="{Binding PermitCommand}"
                                Background="#F472B6" Foreground="White" />
						<Button Content="Restrict" Command="{Binding RestrictCommand}"
                                Background="#F472B6" Foreground="White" />
					</StackPanel>

					<TextBlock Text="{Binding StatusMessage}" Foreground="#BE185D" TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</UserControl>
