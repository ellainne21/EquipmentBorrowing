<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="450"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

	<Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*" RowSpacing="8">

		<TextBlock Grid.Row="0" Text="Active Borrowings"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#831843" />

		<StackPanel Grid.Row="1" Spacing="4" IsVisible="{Binding IsLoading}">
			<TextBlock Text="Loading active borrowings..." Foreground="#831843" />
			<ProgressBar IsIndeterminate="True" />
		</StackPanel>

		<Grid Grid.Row="2">
			<ListBox Background="Transparent"
                     ItemsSource="{Binding ActiveBorrowings}"
                     SelectedItem="{Binding SelectedBorrowing}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Padding="10" Margin="0,2" Background="White"
                                BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="6">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
								<TextBlock Grid.Column="0" Text="{Binding BorrowingId}" FontWeight="Bold" Width="50" Foreground="#831843" />
								<TextBlock Grid.Column="1" Text="{Binding StudentName}" />
								<TextBlock Grid.Column="2" Text="{Binding EquipmentName}" />
								<TextBlock Grid.Column="3" Text="{Binding ExpectedReturnDate, StringFormat='Due {0:MM/dd/yyyy}'}" />
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Empty state -->
			<TextBlock Text="There are no active borrowings." IsVisible="{Binding IsEmpty}"
                       Foreground="#831843" VerticalAlignment="Top" Margin="4" />

			<!-- Error state -->
			<StackPanel IsVisible="{Binding HasLoadError}" Spacing="8" VerticalAlignment="Top" Margin="4">
				<TextBlock Text="{Binding LoadError}" Foreground="#B91C1C" TextWrapping="Wrap" />
				<Button Content="Retry" Command="{Binding RefreshCommand}"
                        Background="#F472B6" Foreground="White" />
			</StackPanel>
		</Grid>

		<Border Grid.Row="3" Padding="12" Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="8">
			<StackPanel Spacing="8">
				<Button Content="Return Equipment"
                        Command="{Binding ReturnCommand}"
                        HorizontalAlignment="Left"
                        Background="#F472B6"
                        Foreground="White" />

				<TextBlock Text="{Binding StatusMessage}"
                           Foreground="#BE185D"
                           TextWrapping="Wrap" />
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
